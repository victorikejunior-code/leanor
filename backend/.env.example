# --- Astra DB (create a free database at https://astra.datastax.com) ---
# Database Details page -> API endpoint, and Generate Token -> application token
ASTRA_DB_API_ENDPOINT=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-us-east-2.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_application_token_here

# Collection that stores the submissions (created automatically if missing)
ASTRA_COLLECTION=submissions

# auto = use Astra when the two values above are set, otherwise in-memory (local dev)
# astra = require Astra, fail at startup if it cannot connect
# memory = never touch Astra (data is lost when the server stops)
STORAGE_BACKEND=auto

# --- Admin inbox -------------------------------------------------------------
# Email + password are BOTH required at sign-in. If either is empty, every
# sign-in attempt is rejected (nobody gets in).
ADMIN_EMAIL=admin@example.com
# Password for the private /admin page. LEAVE THIS SET in production:
# with an empty password anyone can read every submission.
ADMIN_PASSWORD=change-me

# Signs the short-lived admin session tokens. Any long random string.
# Falls back to a value derived from ADMIN_PASSWORD when left empty.
TOKEN_SECRET=

# How long a signed-in admin session stays valid, in hours.
TOKEN_TTL_HOURS=12

# --- Web ---------------------------------------------------------------------
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:39573,http://127.0.0.1:39573

# --- Upload guardrails -------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_PICTURES=8
# ID card photographs: front and back
MAX_ID_CARDS=2